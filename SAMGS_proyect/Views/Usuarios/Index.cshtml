
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="">
<meta name="author" content="">

<script type="text/javascript" src="https://code.jquery.com/jquery-3.7.0.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>



<script src="~/Scripts/MScripts/MenuUsuarios.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        obtenerPersona();
        ObtenerEmpleados();
        catPerfil(1);
        catDeptos(2);
    });
</script>

@Styles.Render("~/Content/cssSAMGS")

<div id="content">
    @Html.Partial("_Layout_Cabecera")

    <div class="container-fluid">
        <!-- Page Heading -->
        <h1 class="h3 mb-2 text-gray-800">Usuarios</h1>
        <p class="mb-4">
            En esta seccion, podra dar de alta los usuarios del sistema
        </p>

        <!-- DataTales Example -->
        <div class="card shadow mb-4">

            <div class="card-body">
                <div class="table-responsive">
                    <button type='button' class='btn btn-success' data-toggle='modal' data-target='#usuariosModal' onclick='limpiadatos(this)'>Agregar Usuario</button>
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>id</th>
                                <th>Usuario</th>
                                <th>UserName</th>
                                <th>Usuario Corporativo</th>
                                <th>PerfilId</th>
                                <th>Departamento</th>
                                <th>Pasword</th>
                                <th>PreguntaSecreta</th>
                                <th>RespuestaSecreta</th>
                                <th>Estatus</th>
                                <th>CaducaUsuario</th>
                                <th>Empleado</th>
                                <th>Sel</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>id</th>
                                <th>Usuario</th>
                                <th>UserName</th>
                                <th>Usuario Corporativo</th>
                                <th>PerfilId</th>
                                <th>Departamento</th>
                                <th>Pasword</th>
                                <th>PreguntaSecreta</th>
                                <th>RespuestaSecreta</th>
                                <th>Estatus</th>
                                <th>CaducaUsuario</th>
                                <th>Empleado</th>
                                <th>Sel</th>

                            </tr>
                        </tfoot>
                        <tbody>
                            <!--inserto datos-->

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <!-- /.container-fluid -->

</div>

<div class="modal" id="usuariosModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <!-- DataTales Example -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Datos del Usuario</h6>
                        </div>
                        <div class="form-group row ">
                            <div class="card-body">
                                <form id=" miForm">
                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtId" data-value="txtid"
                                               placeholder="User ID" disabled="true">
                                    </div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtNom"
                                               placeholder="Nombre de usuario">
                                    </div>


                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="idCheck" data-toggle='modal' data-target='#EmpleadosModal'>
                                            <label class="form-check-label" for="idCheck">
                                                Es empleado
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="CheckCadu" data-toggle='modal'>
                                            <label class="form-check-label" for="CheckCad">
                                                Caduca Contraseña
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="CheckEstatus" data-toggle='modal'>
                                            <label class="form-check-label" for="CheckEstatus">
                                                Estatus
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtUserCorp"
                                               placeholder="Usuario Corporativo">
                                    </div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtUserName"
                                               placeholder="Usuario">
                                    </div>
                                    <div class="mb-3">
                                        <input type="password" class="form-control form-control-user" id="txtPassword"
                                               placeholder="Password">
                                    </div>
                                    <div class="mb-3">
                                        @*<input type="text" class="form-control form-control-user" id="txtPerfilId" placeholder="Perfil">*@
                                        <select class="form-select form-control form-control-user" aria-label="Default select example" id="cmbPerfiles">
                                        <!--datos del perfil-->
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        @*<input type="text" class="form-control form-control-user" id="txtidDepto" placeholder="Departamento">*@
                                        <select class="form-select form-control form-control-user" aria-label="Default select example" id="cmbDeptos">
                                            <!--datos del perfil-->
                                        </select>

                                    </div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtisPreguntaSecreta"
                                               placeholder="Pregunta">
                                    </div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtisRespuestaSecreta"
                                               placeholder="Respuesta">
                                    </div>


                                </form>

                            </div>
                        </div>

                        <!--</div>-->
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="button" data-dismiss="modal" id="btnGUarda" onclick='validarDatos(this)'>Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="EmpleadosModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">X</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                        <div class="card border-left-primary shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                   
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">

                                             DataTales Example 
                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="tableEmpleado" width="100%" cellspacing="0">
                                                    <thead>
                                                        <tr>
                                                            <th>id</th>
                                                            <th>Nombre</th>
                                                            <th>Sel</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>id</th>
                                                            <th>Nombre de Empleado</th>
                                                            <th>Sel</th>

                                                        </tr>
                                                    </tfoot>
                                                    <tbody>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        
                                    
                                    
                                </div>
                            </div>
                        </div>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

