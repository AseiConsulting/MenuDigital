
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="">
<meta name="author" content="">

<script type="text/javascript" src="https://code.jquery.com/jquery-3.7.0.js"></script>

<script src="~/Scripts/MScripts/Pruebaconet.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        agregaAlPrincipal();
    });
</script>

@Styles.Render("~/Content/cssSAMGS")



<div id="content">

    <div class="container-fluid">
        @Html.Partial("_Layout_Cabecera")
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Catálogo de Perfiles</h6>
            </div>
            <div class="card-body col-sm-12 small ">
                <div class="table-responsive small">
                    <button type='button' class='btn btn-success' data-toggle='modal' data-target='#deptosModal' onclick='(this)'>Agregar Perfil</button>
                    <table class="table table-bordered table table-striped  table-hover" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th scope="col">IDPerfil</th>
                                <th scope="col">Descripción</th>
                                <th>Sel</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                            <tr>
                                <th scope="col">IDPerfil</th>
                                <th scope="col">Descripción</th>
                                <th>Sel</th>
                            </tr>

                        </tfoot>
                        <tbody id="bodytable">
                            <!--Datos de la tabla-->

                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div> <!-- /.container-fluid -->
</div>
<div class="modal" id="deptosModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <!-- DataTales Example -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Catálogo de Perfiles</h6>
                        </div>
                        <div class="form-group row ">
                            <div class="card-body">
                                <form>
                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtid" data-value="txtId"
                                               placeholder="Id Perfil" maxlength="13">
                                    </div>
                                    <div></div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtDescripcion"
                                               placeholder="Descripcion Perfil">
                                    </div>
                                </form>

                            </div>
                        </div>

                        <!--</div>-->
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="button" data-dismiss="modal" id="btnGUarda" onclick='AddUpDepto(this)'>Guardar</button>
            </div>
        </div>
    </div>
</div>

