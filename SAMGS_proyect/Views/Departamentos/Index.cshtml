
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}


<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="">
<meta name="author" content="">

<script type="text/javascript" src="~/vendor/jquery/jquery-3.7.0.js"></script>

<script src="~/Scripts/MScripts/Pruebaconet.js"></script>
<script src="~/js/demo/datatables-demo.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        agregaAlPrincipal();
    });
</script>

@Styles.Render("~/Content/cssSAMGS")

<div id="content">
    @Html.Partial("_Layout_Cabecera")

    <div class="container-fluid">
        <!-- Page Heading -->
        <h1 class="h3 mb-2 text-gray-800">Departamentos</h1>
        <p class="mb-4">
            En esta seccion, podra dar de alta los departamentos existentes en su empresa
            <!--<a target="_blank" href="https://datatables.net">official DataTables documentation</a>.-->
        </p>

        <!-- DataTales Example -->
        <div class="card shadow mb-4">

            <div class="card-body">
                <div class="table-responsive">
                    <button type='button' class='btn btn-success' data-toggle='modal' data-target='#clientesModal' onclick='limpiadatos(this)'>Agregar Departamento</button>
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>iD</th>
                                <th>ID Departamento</th>
                                <th>Sel</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>ID</th>
                                <th> ID Departamento</th>
                                <th>Sel</th>

                            </tr>
                        </tfoot>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Operaciones</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Riesgos</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>Contabilidad</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>Fideicomisos</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                            </tr>
                            <tr>
                                <td>7</td>
                                <td>Departamento 7</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>8</td>
                                <td>Departamento 8</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>9</td>
                                <td>Departamento 9</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>10</td>
                                <td>Departamento 10</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>11</td>
                                <td>Departamento 11</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>
                            <tr>
                                <td>12</td>
                                <td>Departamento 12</td>
                                <td> <button type='button' class='btn btn-success btn-primary ' data-toggle='modal' data-target='#clientesModal' onclick='regresadatos(this)'></button></td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <!-- /.container-fluid -->

</div>

<div class="modal" id="clientesModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <!-- DataTales Example -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Catálogo de departamento</h6>
                        </div>
                        <div class="form-group row ">
                            <div class="card-body">
                                <form>
                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id="txtRFC" data-value="txtrfc"
                                               placeholder="id Deparatmento" maxlength="13">
                                    </div>
                                    <div></div>

                                    <div class="mb-3">
                                        <input type="text" class="form-control form-control-user" id=",sDescripcion"
                                               placeholder="Descripcion">
                                    </div>

                                    
                                </form>

                            </div>
                        </div>

                        <!--</div>-->
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="button" data-dismiss="modal" id="btnGUarda" onclick='AddDepto(this)'>Guardar</button>
            </div>
        </div>
    </div>
</div>